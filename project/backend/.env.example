DATABASE_URL="postgresql://nrtsms:nrtsms_dev_only@localhost:5432/nrtsms"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="dev-only-change-me-32-chars-minimum-123456"
JWT_REFRESH_SECRET="dev-only-refresh-change-me-32-chars-min"
PORT=3001
S3_ENDPOINT=""
S3_BUCKET="nrtsms-uploads"
SMTP_HOST=""
LEGACY_API_BASE="https://ok-go.in/api/"

# Provider selection (mock = local dev, no network). Set to vendor name when real impl lands.
PROVIDER_SMS=mock
PROVIDER_WA=mock
PROVIDER_VOICE=mock

# Queue driver: memory (default local dev) or redis (requires REDIS_URL).
QUEUE_DRIVER=memory

# SMS vendor placeholders — all endpoints/keys via env, never hard-coded.
SMS_VENDOR_BASE=""
SMS_VENDOR_KEY=""
SMS_VENDOR_USER=""
SMS_VENDOR_PASSWORD=""

# WhatsApp vendor placeholders.
WA_BASE_URL=""
WA_TOKEN=""
WA_PHONE_ID=""
WA_API_KEY=""

# Voice vendor placeholders.
VOICE_BASE_URL=""
VOICE_API_KEY=""
VOICE_VENDOR_KEY=""

# Supabase (server-only, optional — used at P8 for Postgres/Auth integration).
# Never expose these to the frontend bundle.
# SUPABASE_URL=""
# SUPABASE_SECRET_KEY=""
# SUPABASE_JWKS_URL=""

# Demo login seed (in-memory MVP; TODO: move to Prisma User when DB is live).
# Change ADMIN_PASSWORD before sharing / going live, or call POST /api/v1/auth/change-password later.
ADMIN_EMAIL="admin@local.dev"
ADMIN_PASSWORD="Admin@123"
RESELLER_PASSWORD="Reseller@123"
CUSTOMER_PASSWORD="Customer@123"

# Database: local Postgres (compose) OR Supabase Postgres (set DATABASE_URL to the
# Supabase connection string when ready — no code change required, Prisma only).
